{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"], "types": ["node"], "strict": true,
    "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "jsx": "preserve", "jsxImportSource": "@opentui/solid",
    "esModuleInterop": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["tui.tsx", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"]
}
