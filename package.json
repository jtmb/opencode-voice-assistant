{
  "name": "opencode-voice-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local hands-free speech input and output for the OpenCode v2 TUI",
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test && .venv/bin/python -m ruff check audio tests scripts && .venv/bin/python -m mypy audio && .venv/bin/python -m pytest -q",
    "smoke:audio": ".venv/bin/python scripts/audio_smoke.py"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.1",
    "jsonc-parser": "3.3.1"
  },
  "peerDependencies": {
    "@opencode/theme": "2.1.1",
    "@opentui/core": ">=0.6.6 <0.7.0",
    "@opentui/solid": ">=0.6.6 <0.7.0",
    "solid-js": ">=1.9.0 <2.0.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.1.1",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/node": "24.12.2",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
}
